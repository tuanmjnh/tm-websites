{
  "name": "tm-websites",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev:cms": "pnpm --dir tm-cms run dev",
    "dev:web": "pnpm --dir tm-web run dev",
    "build:cms": "pnpm --dir tm-cms run build:vercel",
    "build:web": "pnpm --dir tm-web run build:vercel",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "validate:registry": "tsx scripts/build/validate-registry.ts",
    "validate:build:cms": "tsx scripts/build/validate-build.ts cms",
    "validate:build:web": "tsx scripts/build/validate-build.ts web",
    "verify:scaffold": "tsx scripts/verify-scaffold.ts",
    "verify:audit-meta": "tsx scripts/build/verify-audit-meta.ts",
    "verify:modules": "tsx scripts/build/verify-modules.ts",
    "verify:audit-reason-ui": "tsx scripts/build/verify-audit-reason-ui.ts",
    "verify:error-answers": "tsx scripts/build/verify-error-answers.ts",
    "test:layers": "tsx scripts/build/test-layer-priority.ts",
    "test:hub": "tsx scripts/build/test-hub-contracts.ts",
    "test:web-content": "tsx scripts/build/test-web-content.ts && tsx scripts/build/test-web-content-db.ts",
    "test:web-cart": "tsx scripts/build/test-web-cart.ts",
    "test:web-routes": "tsx scripts/build/test-web-routes.ts",
    "test:iam": "tsx scripts/build/test-cms-iam.ts",
    "test:refresh-coordinator": "tsx scripts/build/test-refresh-coordinator.ts",
    "hub:check": "tsx scripts/build/check-hub.ts",
    "cache:clear": "rimraf tm-cms/.nuxt tm-web/.nuxt tm-cms/.output tm-web/.output node_modules/.cache node_modules/.vite",
    "test:db": "tsx scripts/build/test-database-binding.ts",
    "test:content": "tsx scripts/build/test-content-model.ts && tsx scripts/build/test-content-service.ts",
    "test:categories": "tsx scripts/build/test-category-service.ts",
    "test:catalog": "tsx scripts/build/test-catalog-service.ts",
    "test:migrate-apply": "tsx scripts/build/test-migrate-apply.ts",
    "test:media": "tsx scripts/build/test-media-service.ts",
    "test:audit": "tsx scripts/build/test-audit-service.ts",
    "test:audit-write": "tsx scripts/build/test-audit-write.ts",
    "test:backup-restore": "tsx scripts/build/test-backup-restore.ts",
    "test:media-backup": "tsx scripts/build/test-media-backup.ts",
    "test:backup-bundle": "tsx scripts/build/test-backup-bundle.ts",
    "test:purge-scope": "tsx scripts/build/test-purge-scope.ts",
    "test:price": "tsx scripts/build/test-price.ts",
    "test:legacy-import": "tsx scripts/build/test-legacy-import.ts",
    "test:settings": "tsx scripts/build/test-settings-service.ts",
    "test:menus": "tsx scripts/build/test-menu-service.ts",
    "test:web-site": "tsx scripts/build/test-web-site.ts",
    "test:revalidate": "tsx scripts/build/test-storefront-revalidate.ts",
    "test:web-site-db": "tsx scripts/build/test-web-site-db.ts",
    "test:retention": "tsx scripts/build/test-retention-service.ts",
    "prune:retention": "tsx scripts/ops/prune-retention.ts",
    "backup:database": "tsx scripts/ops/backup-database.ts",
    "restore:database": "tsx scripts/ops/restore-database.ts",
    "backup:media": "tsx scripts/ops/backup-media.ts",
    "restore:media": "tsx scripts/ops/restore-media.ts",
    "backup:all": "tsx scripts/ops/backup-all.ts",
    "restore:all": "tsx scripts/ops/restore-all.ts",
    "migrate:catalog": "tsx scripts/ops/migrate-catalog.ts",
    "migrate:content": "tsx scripts/ops/migrate-content.ts",
    "test:bulk": "tsx scripts/build/test-bulk-service.ts",
    "test:tags": "tsx scripts/build/test-tag-service.ts",
    "test:category-order": "tsx scripts/build/test-category-reorder.ts",
    "test:redirects": "tsx scripts/build/test-redirect-service.ts",
    "test:empty-listing": "tsx scripts/build/test-empty-listing.ts",
    "test:pwa-isolation": "tsx scripts/build/test-pwa-isolation.ts",
    "test:build-matrix": "tsx scripts/build/test-build-matrix.ts",
    "verify:all": "tsx scripts/build/run-gates.ts"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^24.19.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
