# TM Hub control plane URL used by the CMS BFF.
TM_HUB_URL=https://tm-hub-app.vercel.app

# hub = authenticate against TM Hub via the BFF (production default)
# mock = local-only fake session, rejected on Vercel builds
TM_AUTH_MODE=hub

# Customer layer selected when TM_CUSTOMER_ID is not provided by the host.
TM_CUSTOMER_ID=sentuan

# Provisioned Hub app id for this CMS installation.
# Leave empty to fall back to the customer registry value (app_<customer>_cms).
TM_CMS_APP_ID=

# Hub app that owns the public Website content this CMS edits.
# Leave empty to fall back to the paired Website app (app_<customer>_web),
# or to TM_CMS_APP_ID for customers without a Website build.
TM_CONTENT_APP_ID=

# Optional override; defaults to the customer registry tenant.
TM_TENANT_ID=

# Optional Hub app API key. Server-only; never expose as NUXT_PUBLIC_*.
TM_HUB_SECRET=
