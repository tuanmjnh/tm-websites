# TM Hub control plane URL used by the storefront.
TM_HUB_URL=https://tm-hub-app.vercel.app

# Customer layer selected when TM_CUSTOMER_ID is not provided by the host.
TM_CUSTOMER_ID=sentuan

# Public site identity (Hub multi-site).
TM_SITE_ID=main

# Provisioned Hub app id for this storefront.
# Leave empty to fall back to the customer registry value (app_<customer>_web).
TM_WEB_APP_ID=

# Optional override; defaults to the customer registry tenant.
TM_TENANT_ID=

# Absolute public origin used for canonical URLs, sitemap.xml and robots.txt.
# Leave empty to derive it from the incoming request (local development).
TM_SITE_URL=

# Set to false on preview/staging deployments to emit noindex and block crawlers.
TM_SITE_INDEXABLE=true

# ISO currency code used to format catalog prices.
TM_CURRENCY=VND

# Remote image hosts allowed by @nuxt/image (comma separated).
TM_IMAGE_DOMAINS=res.cloudinary.com,images.unsplash.com,images.pexels.com

# ---------------------------------------------------------------------------
# Server-only (never exposed to the browser, never prefixed with NUXT_PUBLIC_).
# The storefront reads its catalog through the BFF, so these stay on the server.
# ---------------------------------------------------------------------------

# MongoDB connection for the customer catalog. Defaults to the customer registry
# `dataSources.mongo.database` when TM_MONGO_DB is empty.
TM_MONGO_URI=mongodb://127.0.0.1:27017
TM_MONGO_DB=

# Shared secret for POST /api/_internal/purge (purges the Nitro response cache).
# Leave empty to keep the endpoint disabled (it answers 503).
REVALIDATE_SECRET=
