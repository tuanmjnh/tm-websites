# TM Platform — pnpm configuration
# Nuxt layers resolve many transitive peers; hoisting mirrors the legacy
# nuxt4-cms / nuxt4-website setup so layer auto-discovery behaves identically.
shamefully-hoist=true

# Fail loudly instead of silently skipping a broken peer.
strict-peer-dependencies=false
auto-install-peers=true

# Layer packages are consumed as TypeScript sources (main -> nuxt.config.ts),
# so they must never be pruned from the store.
node-linker=isolated
